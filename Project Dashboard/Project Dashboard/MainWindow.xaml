<Window x:Class="Project_Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Project_Dashboard.ViewModels"
        xmlns:models="clr-namespace:Project_Dashboard.Models"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Task Tracker"
        Icon="Resources/app_icon.png"
        FontFamily="Times New Roman"
        FontSize="14"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="NoResize">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Шапка -->
            <RowDefinition Height="Auto"/> <!-- Панель аналитики -->
            <RowDefinition Height="Auto"/> <!-- Поиск и фильтрация -->
            <RowDefinition Height="Auto"/> <!-- Заголовки таблицы -->
            <RowDefinition Height="*"/>    <!-- Список задач -->
        </Grid.RowDefinitions>

        <!-- Шапка: Заголовок и кнопки управления -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Мой дашборд проектов" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Кнопка смены темы -->
                <Button Command="{Binding ToggleThemeCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="Сменить тему"
                        Width="40" Height="40" Padding="0" Margin="0,0,10,0"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}">
                    <materialDesign:PackIcon Kind="ThemeLightDark" Width="22" Height="22"/>
                </Button>
                <!-- Управление данными (Импорт/Экспорт/Сброс) -->
                <materialDesign:PopupBox ToolTip="Управление данными (Импорт, Экспорт, Сброс)"
                                         PlacementMode="BottomAndAlignRightEdges"
                                         Width="40" Height="40" Margin="0,0,10,0"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}">
                    <materialDesign:PopupBox.ToggleContent>
                        <materialDesign:PackIcon Kind="Database" Width="24" Height="24" />
                    </materialDesign:PopupBox.ToggleContent>
                    <StackPanel Width="220" Margin="5">
                        <Button Command="{Binding ExportTasksCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Экспорт задач (JSON)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportTasksCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Импорт задач (JSON)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0,5" Background="{DynamicResource MaterialDesign.Brush.TextBox.Border}"/>
                        <Button Command="{Binding GenerateDemoDataCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabasePlus" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Создать демо-данные" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetDatabaseCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" HorizontalContentAlignment="Left" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseRemove" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Сбросить базу данных" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>
                <!-- Добавить задачу -->
                <Button Command="{Binding AddTaskCommand}" 
                        Style="{StaticResource MaterialDesignFloatingActionSecondaryButton}"
                        ToolTip="Добавить задачу"
                        Width="45" Height="45">
                    <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Панель аналитики и статистики -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Всего задач -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="15,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="ClipboardListOutline" Width="36" Height="36" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalTasksCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="Всего задач" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- В работе -->
            <Border Grid.Column="1" Margin="0,0,10,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="15,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="36" Height="36" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InProgressTasksCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="В работе" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Выполнено -->
            <Border Grid.Column="2" Margin="0,0,10,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="15,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="36" Height="36" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CompletedTasksCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="Выполнено" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Просрочено -->
            <Border Grid.Column="3" Margin="0,0,10,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="15,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="36" Height="36" Foreground="#F44336" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OverdueTasksCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="Просрочено" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Общий прогресс (Круговой индикатор) -->
            <Border Grid.Column="4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="15,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ProgressBar Value="{Binding OverallProgressPercentage}" 
                                     Minimum="0" Maximum="100"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Width="38" Height="38"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <TextBlock Text="{Binding OverallProgressPercentage, StringFormat={}{0:0}%}" 
                                   FontSize="10" FontWeight="Bold" 
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Общий прогресс" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="всех задач" FontSize="10" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Панель поиска, фильтрации и сортировки -->
        <Border Grid.Row="2" Margin="0,0,0,15" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Padding="15,10" SnapsToDevicePixels="True" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск задач -->
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск по названию или описанию..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="38" Padding="10,8" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                <!-- Фильтр по приоритету -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Приоритет: " VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,5,0"/>
                    <ComboBox SelectedValue="{Binding SelectedPriorityFilter, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="38" Width="110" Padding="10,8" VerticalContentAlignment="Center">
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Все</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Low</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Medium</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">High</System:String>
                    </ComboBox>
                </StackPanel>

                <!-- Фильтр по статусу -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Статус: " VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,5,0"/>
                    <ComboBox SelectedValue="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="38" Width="130" Padding="10,8" VerticalContentAlignment="Center">
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Все</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">В процессе</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Выполненные</System:String>
                    </ComboBox>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка: " VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,5,0"/>
                    <ComboBox SelectedValue="{Binding SelectedSortProperty, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="38" Width="150" Padding="10,8" VerticalContentAlignment="Center">
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Без сортировки</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Дата начала</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Дедлайн</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Прогресс</System:String>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Шапка таблицы: Задачи и временная шкала -->
        <Grid Grid.Row="3" Margin="0,0,0,10" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Height="40" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Left Header -->
            <TextBlock Text="Задачи" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.8" VerticalAlignment="Center" Margin="15,0,0,0"/>
            
            <!-- Right Header: Days of timeline -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding TimelineHeaders}" Margin="10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="30"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Список задач (Скроллируемый) -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding TasksView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ProjectTask}">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="8" Margin="0,4" Padding="5,10" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Левая колонка: Детали задачи -->
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        
                                        <!-- Баджи: Приоритет и Категория -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <!-- Приоритет -->
                                            <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                <Setter Property="Background" Value="#FF9800"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                <Setter Property="Background" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Priority}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Категория -->
                                            <Border Background="{Binding CategoryBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" Foreground="#212121" FontSize="9" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Предупреждение о конфликте зависимости -->
                                            <Border Background="#F44336" CornerRadius="3" Padding="6,2" ToolTip="Конфликт сроков с зависимой задачей!">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDependencyConflict}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Alert" Width="10" Height="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="Конфликт" Foreground="White" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Кнопки управления -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Редактировать -->
                                        <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Padding="0" Margin="0,0,4,0"
                                                ToolTip="Редактировать задачу">
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                        </Button>
                                        
                                        <!-- Удалить -->
                                        <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Padding="0"
                                                ToolTip="Удалить задачу">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Правая колонка: Диаграмма (Временная шкала) -->
                                <Grid Grid.Column="1" Margin="10,0">
                                    <!-- Линии сетки на фоне -->
                                    <UniformGrid Rows="1" Columns="30" Opacity="0.3">
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}" BorderThickness="1,0,0,0"/>
                                    </UniformGrid>
                                    
                                    <!-- Сетка для позиционирования полосы задачи -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Полоса задачи на диаграмме -->
                                        <Grid Grid.Column="{Binding StartColumn}" Grid.ColumnSpan="{Binding ColumnSpan}" 
                                              VerticalAlignment="Center" Height="26">
                                            
                                            <!-- Всплывающая подсказка с датами и деталями -->
                                            <Grid.ToolTip>
                                                <ToolTip Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" BorderThickness="1" Padding="10">
                                                    <StackPanel Width="220">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7" Margin="0,5" TextWrapping="Wrap"/>
                                                        <Separator Background="{DynamicResource MaterialDesign.Brush.TextBox.Border}"/>
                                                        <TextBlock Text="{Binding StartDate, StringFormat='Начало: dd.MM.yyyy'}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.8" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Deadline, StringFormat='Конец: dd.MM.yyyy'}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.8"/>
                                                        <TextBlock Text="{Binding Category, StringFormat='Категория: {0}'}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.8"/>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.8">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding DependsOnTask.Title, StringFormat='Зависит от: {0}'}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DependsOnTask}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Progress, StringFormat='Выполнено: {0:0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                            
                                            <!-- Прогресс-бар для отображения прогресса в полосе -->
                                            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="24" BorderThickness="0" Background="{DynamicResource MaterialDesign.Brush.Background}" Foreground="{Binding CategoryColor}"/>
                                                                                        <!-- Текст с процентом и иконка предупреждения -->
                                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                 <materialDesign:PackIcon Kind="Alert" Width="12" Height="12" Foreground="#FFEB3B" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Конфликт сроков: начало задачи раньше завершения зависимой!">
                                                     <materialDesign:PackIcon.Style>
                                                         <Style TargetType="materialDesign:PackIcon">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsDependencyConflict}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </materialDesign:PackIcon.Style>
                                                 </materialDesign:PackIcon>
                                                 <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" 
                                                            FontSize="10" FontWeight="Bold" Foreground="White"
                                                            VerticalAlignment="Center"/>
                                             </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>