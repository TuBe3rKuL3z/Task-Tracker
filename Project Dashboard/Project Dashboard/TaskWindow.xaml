<Window x:Class="Project_Dashboard.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Project_Dashboard.Models"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Информация о задаче" Height="600" Width="400"
        Icon="Resources/app_icon.png"
        FontFamily="Times New Roman"
        FontSize="14"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Редактирование задачи" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,15"/>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Title -->
                <TextBox x:Name="TitleTextBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Название задачи"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="14" Margin="0,0,0,15"/>

                <!-- Description -->
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Описание"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="80" FontSize="14" Margin="0,0,0,15"/>

                <!-- Start Date -->
                <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Дата начала"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            FontSize="14" Margin="0,0,0,15"/>

                <!-- Deadline -->
                <DatePicker SelectedDate="{Binding Deadline, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Срок исполнения"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            FontSize="14" Margin="0,0,0,15"/>

                <!-- Priority -->
                <ComboBox SelectedValue="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:HintAssist.Hint="Приоритет"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          FontSize="14" Margin="0,0,0,15">
                    <models:PriorityLevel>Low</models:PriorityLevel>
                    <models:PriorityLevel>Medium</models:PriorityLevel>
                    <models:PriorityLevel>High</models:PriorityLevel>
                </ComboBox>

                <!-- Category / Project -->
                <ComboBox x:Name="CategoryComboBox"
                          Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          materialDesign:HintAssist.Hint="Категория / Проект"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          FontSize="14" Margin="0,0,0,15"/>

                <!-- DependsOnTaskId (Dependency) -->
                <ComboBox x:Name="DependsOnComboBox"
                          SelectedValue="{Binding DependsOnTaskId, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="DisplayText"
                          materialDesign:HintAssist.Hint="Зависит от задачи"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          FontSize="14" Margin="0,0,0,15"/>

                <!-- Progress -->
                <TextBlock Text="Прогресс выполнения" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,5,0,0"/>
                <Grid Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="100" 
                            Value="{Binding Progress, UpdateSourceTrigger=PropertyChanged}" 
                            Style="{StaticResource MaterialDesignDiscreteSlider}" 
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}" 
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" 
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
